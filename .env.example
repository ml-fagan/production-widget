# Fill these in Vercel once IT completes the Entra app registration.
# All three come from the Azure app registration (Sites.Selected, read-only).

AZURE_TENANT_ID=your-decor-systems-tenant-id
AZURE_CLIENT_ID=app-registration-client-id
AZURE_CLIENT_SECRET=app-registration-client-secret

# Shared password that gates the whole feed to Decor Systems staff.
# Set this to whatever you want the team to type once to unlock. If left unset,
# the feed is open to anyone with the link (middleware fails open).
FEED_PASSWORD=choose-a-shared-password

# The SharePoint site path and filename are set in lib/graph.js — change them
# there only if Jordan moves or renames the file.

# Asana Personal Access Token, used to cross-check each job's dispatch date
# against the Due date on its task in the "3. Production" Asana project.
# Create one at Asana -> profile photo -> My Settings -> Apps ->
# Manage Developer Apps -> New Access Token. If unset, the check column just
# shows a warning on every row instead of failing the whole page.
ASANA_TOKEN=asana-personal-access-token
